# Public. Inlined into the browser bundle at build time — set these before `next build`
# or a Vercel deploy, then rebuild. The anon key is the public Data API key (not the service role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security. Never prefix with NEXT_PUBLIC_ and never commit a real value.
# Required for the Supabase repository adapter: public reads, booking inserts, signed clip URLs, and seeding.
# Owner edits use the signed-in user's session instead, and still need the anon key above.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public origin for auth email links, with no trailing slash.
# When unset, the server uses the incoming request host. Set this in production when that
# host is not the URL people open from email (for example https://gigmap.example).
# NEXT_PUBLIC_SITE_URL=
